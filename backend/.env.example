# ==============================================================================
# CP_kerby Backend Server Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Database & Auth)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection string for migrations (via `npm run db:push`)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# ------------------------------------------------------------------------------
# 3. AI Concierge & Chat Assistant
# ------------------------------------------------------------------------------
# Provider: Groq Cloud (Recommended for ultra-fast Llama-3.3 inference)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Provider: xAI Grok (Alternative)
XAI_API_KEY=your_xai_api_key_here
AI_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 4. Google Drive Cloud Storage (Property Media & Agent Credentials)
# ------------------------------------------------------------------------------
# Option A: Service Account (Recommended for Google Workspace Shared Drive)
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=drive-uploader@your-gcp-project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-folder-id

# Option B: Personal Google Drive OAuth (Generate with `npm run drive:auth`)
GOOGLE_DRIVE_REFRESH_TOKEN=

# Force Google Drive mock storage in development (true/false)
GOOGLE_DRIVE_MOCK_MODE=false

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 SSO (Agent & Client Social Login)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 6. Google Mail (Gmail API & Onboarding Invitations)
# ------------------------------------------------------------------------------
# Method A (Official Cloud API): Generate via `npm run gmail:auth` using Google Client credentials
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=your-real-email@gmail.com

# Method B (Alternative): Google Account App Password (16 characters)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ------------------------------------------------------------------------------
# 7. Integration Mock Mode Control
# ------------------------------------------------------------------------------
# Set to 'false' to enable live email dispatch and real cloud service calls in development.
# When 'true' (or omitted in dev without Google credentials), emails are logged to console without network dispatch.
IS_MOCK_MODE=false

# ------------------------------------------------------------------------------
# 8. WhatsApp Cloud API (Meta Graph API)
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-system-user-token
WHATSAPP_VERIFY_TOKEN=cp_kerby_whatsapp_verify_token

# ------------------------------------------------------------------------------
# 9. Geocoding & Mapping Services
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=CP_kerby_Platform/1.0 (concierge@cpkerby.luxury)
NOMINATIM_MOCK_MODE=false
