# ==========================================
# Full-Stack Monorepo Environment Variables
# ==========================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Backend Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend Client Configuration (Connects exclusively to Backend API)
VITE_API_BASE_URL=http://localhost:5000/api

# AI Assistant Configuration (Supports Groq Cloud or xAI Grok)
GROQ_API_KEY=your-groq-api-key-here
XAI_API_KEY=your-xai-api-key-here

# ==========================================
# External Service Integrations
# ==========================================
# 1. Google Drive Cloud Storage (Service Account)
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-gcp-project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-folder-id

# 2. Google OAuth SSO
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 3. Google Mail / Gmail Transactional API
GMAIL_USER_EMAIL=concierge@yourdomain.com

# 4. WhatsApp Cloud API (Meta Graph API)
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-system-user-token
WHATSAPP_VERIFY_TOKEN=cp_kerby_whatsapp_verify_token

# 5. Google Maps Platform
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
