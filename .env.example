# ==============================================================================
# Full-Stack Monorepo Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Client Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Database & Auth)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection string for migrations (via `npm run db:push`)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# ------------------------------------------------------------------------------
# 3. AI Concierge & Chat Assistant
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
XAI_API_KEY=your_xai_api_key_here
AI_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 4. Google Drive Cloud Storage (Property Media & Agent Credentials)
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=drive-uploader@your-gcp-project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-folder-id
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_MOCK_MODE=false

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 SSO (Social Login)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 6. Google Mail (Gmail SMTP & Onboarding Invitations)
# Generate 16-character App Password at: https://myaccount.google.com/apppasswords
# Option A: Run `npm run gmail:auth`
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=your-real-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ------------------------------------------------------------------------------
# 7. Integration Mock Mode Control
# ------------------------------------------------------------------------------
# Set to 'false' to enable live email delivery and real Google Drive uploads.
IS_MOCK_MODE=false

# ------------------------------------------------------------------------------
# 8. WhatsApp Cloud API (Meta Graph API)
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-system-user-token
WHATSAPP_VERIFY_TOKEN=cp_kerby_whatsapp_verify_token

# ------------------------------------------------------------------------------
# 9. Geocoding & Mapping Services
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=CP_kerby_Platform/1.0 (concierge@cpkerby.luxury)
NOMINATIM_MOCK_MODE=false
